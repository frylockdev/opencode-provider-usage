{
  "name": "opencode-provider-usage",
  "version": "0.1.4",
  "description": "OpenAI subscription usage sidebar for OpenCode V2, powered by Codex CLI",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/frylockdev/opencode-provider-usage.git"
  },
  "homepage": "https://github.com/frylockdev/opencode-provider-usage#readme",
  "bugs": {
    "url": "https://github.com/frylockdev/opencode-provider-usage/issues"
  },
  "keywords": ["opencode", "opencode-plugin", "openai", "codex", "usage", "tui"],
  "files": ["src", "dist", "tsconfig.json"],
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./tui": "./dist/tui.js",
    "./rpc": "./src/rpc.ts"
  },
  "scripts": {
    "build:tui": "bun run scripts/build.ts",
    "test:tui": "bun test --preload @opentui/solid/preload tests/*.test.tsx tests/distribution.test.mjs",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@opencode/plugin": "2.2.6"
  },
  "peerDependencies": {
    "@opentui/core": ">=0.8.1",
    "@opentui/solid": ">=0.8.1",
    "solid-js": ">=1.9.0"
  },
  "devDependencies": {
    "@opencode/theme": "2.2.6",
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  }
}
